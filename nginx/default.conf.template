map $http_x_forwarded_proto $bridge_forwarded_proto {
    default $scheme;
    https https;
}

map $http_cf_connecting_ip $bridge_client_ip {
    default $http_cf_connecting_ip;
    "" $remote_addr;
}

map $http_upgrade $bridge_connection_upgrade {
    default upgrade;
    "" close;
}

log_format bridge '$bridge_client_ip - $host [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                  'request_id=$request_id upstream=$upstream_addr upstream_status=$upstream_status '
                  'request_time=$request_time upstream_time=$upstream_response_time';

server {
    listen 127.0.0.1:${EDGE_PORT} default_server;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log bridge;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "bridge ok\n";
    }

    location / {
        return 404;
    }
}

# Application-specific server blocks are generated from validated registration
# manifests by the Bridge CLI. Bridge itself contains no application names.
include /etc/nginx/routes/*.conf;
